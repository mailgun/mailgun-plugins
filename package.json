{
  "name": "mailgun-plugins",
  "version": "0.1.2",
  "private": true,
  "description": "Multi-platform Mailgun agent plugin packages built on @mailgun/mcp-server.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "check:mcp-version": "node scripts/check-mcp-version.mjs",
    "build": "node scripts/build-packages.mjs",
    "build:gemini": "node scripts/build-packages.mjs gemini",
    "bump": "node scripts/bump-version.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:claude": "node scripts/validate-claude.mjs",
    "test": "npm run check:sync && npm run validate && npm run build",
    "mcp:tags": "npx -y @mailgun/mcp-server@2.3.1 --list-tags"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {}
}
